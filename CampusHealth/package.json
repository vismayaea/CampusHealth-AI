{
  "name": "campus-mental-health-platform",
  "version": "1.0.0",
  "description": "Digital mental health and psychological support system for Indian higher education institutions",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "server": "nodemon server.js",
    "build": "cd client && npm run build",
    "install-client": "cd client && npm install",
    "heroku-postbuild": "npm run install-client && npm run build",
    "seed": "node scripts/seed-data.js",
    "seed:resources": "node scripts/seed-resources.js",
    "seed:activities": "node scripts/seed-activities.js",
    "seed:demo": "node scripts/seed-final-demo.js"
  },
  "keywords": [
    "mental-health",
    "education",
    "counseling",
    "ai-chatbot",
    "peer-support",
    "india"
  ],
  "author": "Campus Mental Health Platform Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.0.0",
    "groq-sdk": "^1.3.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.4",
    "openai": "^4.0.0",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
